APP_ENV=development
ALLOW_DEMO_KNOWLEDGE=false
FRONTEND_URL=http://localhost:3000

DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Alias yang masih digunakan oleh beberapa proyek Supabase.
SUPABASE_SERVICE_ROLE_KEY=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

OPENCLAW_API_URL=
# Remote control credentials (distinct from inbound OPENCLAW_API_KEY).
OPENCLAW_GATEWAY_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
OPENCLAW_API_KEY=
# Absolute path is recommended for the Windows service account.
OPENCLAW_CLI_PATH=openclaw

# One-time provisioning only; keep values outside Git.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_DISPLAY_NAME=Super Admin

# Backend-only token used by the Next.js server when calling protected APIs.
# Never expose this value through a NEXT_PUBLIC_* variable.
# Existing demo village used by the local dashboard fallback only.
DASHBOARD_ADMIN_UNIT_ID=00000000-0000-4000-8000-000000000002
KNOWLEDGE_STORAGE_BUCKET=knowledge-files
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
REPORT_DOCUMENT_STORAGE_BUCKET=report-documents
VILLAGE_LOGO_STORAGE_BUCKET=village-logos
PUBLIC_VERIFICATION_URL=https://example.com
REPORT_RATE_LIMIT_PER_HOUR=5

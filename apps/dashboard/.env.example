NEXT_PUBLIC_API_URL=http://localhost:8000
# Hanya URL proyek dan legacy anon key publik; jangan gunakan service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
REPORTS_DATA_SOURCE=mock
# Khusus development mock: normal, empty, error, atau slow.
# REPORTS_MOCK_SCENARIO=normal
# Khusus development aksi status mock: normal, slow, atau error.
# REPORTS_MOCK_MUTATION_SCENARIO=normal
# Pratinjau REQUEST sintetis hanya aktif pada next dev; default nonaktif.
REQUESTS_PREVIEW=off
# Khusus pratinjau REQUEST: normal, empty, error, atau slow.
# REQUESTS_MOCK_SCENARIO=normal
# Khusus keputusan simulasi: normal, slow, error, atau conflict.
# REQUESTS_MOCK_MUTATION_SCENARIO=normal
